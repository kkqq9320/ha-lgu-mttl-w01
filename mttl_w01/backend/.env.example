# Web 상태 조회는 로그인 없이 가능합니다.
# 관리 기능은 사용자명 없이 관리자 암호만 사용합니다. 최초 암호는 admin이며 로그인 후 변경하세요.
# 비밀번호는 .env가 아니라 /data DB에 PBKDF2 해시로 저장됩니다.

# Web UI/API host port only. Device TCP port remains fixed at 10086.
WEB_PORT=8080

# Optional browser-reachable Web URL for Home Assistant device links.
# Example: http://192.168.1.146:18282
MTTL_PUBLIC_WEB_URL=

# Persistent host path. Contains DB/config/key, verified backups and firmware cache/custom FWR files.
DATA_PATH=./data

# INFO is recommended for normal operation. Set DEBUG only while diagnosing protocol issues.
LOG_LEVEL=INFO

# Optional HA MQTT one-time bootstrap.
# If omitted, configure Home Assistant MQTT from the Web UI.
# Once bootstrapped, later Web UI changes are stored in /data and are not overwritten on restart.
HA_MQTT_ENABLED=
HA_MQTT_HOST=
HA_MQTT_PORT=1883
HA_MQTT_USERNAME=
# Prefer Web UI or HA_MQTT_PASSWORD_FILE for secrets. Plain HA_MQTT_PASSWORD is visible to Docker inspect.
HA_MQTT_PASSWORD=
HA_MQTT_PASSWORD_FILE=
HA_MQTT_TLS=false
HA_MQTT_TOPIC_PREFIX=mttl
HA_MQTT_DISCOVERY_PREFIX=homeassistant
HA_MQTT_BIRTH_TOPIC=homeassistant/status

# Device-reachable Backend IPv4 for firmware OTA (1.0.111 primary TCP/49217; TCP/80 retained for 1.0.110 bootstrap/fallback).
OTA_HOST_IP=

# Canonical 1.0.111 OTA primary port; normally leave unchanged.
OTA_PRIMARY_PORT=49217
# Stock/1.0.110 bootstrap and 1.0.111 connect-failure fallback.
OTA_PORT=80
